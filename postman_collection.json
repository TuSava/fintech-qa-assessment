    {
      "name": "01. Identity & Access Management",
      "item": [
        {
          "name": "1.1 Register User (Tenant Alpha) - Success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rand = Math.floor(Math.random() * 1000000);",
                  "const email = `player_alpha_${rand}@fintech.test`;",
                  "pm.collectionVariables.set('regEmailAlpha', email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response time is under 300ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(300);",
                  "});",
                  "const schema = {",
                  "    type: 'object',",
                  "    required: ['user_id', 'email', 'tenant_id', 'wallet_id', 'created_at'],",
                  "    properties: {",
                  "        user_id: { type: 'string' },",
                  "        email: { type: 'string' },",
                  "        tenant_id: { type: 'string', enum: ['tenant_alpha'] },",
                  "        wallet_id: { type: 'string' },",
                  "        created_at: { type: 'string' }",
                  "    }",
                  "};",
                  "pm.test('JSON Schema is valid and no password exposed', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(tv4.validate(jsonData, schema)).to.be.true;",
                  "    pm.expect(jsonData.password).to.be.undefined;",
                  "    pm.expect(jsonData.password_hash).to.be.undefined;",
                  "    pm.collectionVariables.set('userIdAlpha', jsonData.user_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantAlphaId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantAlphaId}}\",\n  \"email\": \"{{regEmailAlpha}}\",\n  \"password\": \"SecurePass123!\",\n  \"currency\": \"EUR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Register User - Duplicate Email Conflict (409)",

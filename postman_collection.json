    {
      "name": "03. PSP Deposit Callbacks (Money In)",
      "item": [
        {
          "name": "3.1 PSP Deposit Callback - Success Credit",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const pspRefId = 'psp_tx_' + Date.now() + '_' + Math.floor(Math.random() * 1000);",
                  "const eventId = 'evt_' + Date.now();",
                  "const timestamp = Math.floor(Date.now() / 1000);",
                  "const amount = 5000; // 50.00 EUR in cents",
                  "pm.collectionVariables.set('lastPspRefId', pspRefId);",
                  "pm.collectionVariables.set('lastDepositEventId', eventId);",
                  "pm.collectionVariables.set('lastDepositTimestamp', timestamp);",
                  "pm.collectionVariables.set('lastDepositAmount', amount);",
                  "",
                  "const payload = JSON.stringify({",
                  "    event_type: 'DEPOSIT_SUCCESS',",
                  "    event_id: eventId,",
                  "    tenant_id: pm.collectionVariables.get('tenantAlphaId'),",
                  "    user_id: pm.collectionVariables.get('userIdAlpha'),",
                  "    psp_reference_id: pspRefId,",
                  "    amount: amount,",
                  "    currency: 'EUR',",
                  "    timestamp: timestamp",
                  "});",
                  "pm.collectionVariables.set('depositPayload', payload);",
                  "",
                  "// Calculate HMAC-SHA256 signature",
                  "const secret = pm.collectionVariables.get('pspSecretAlpha');",
                  "const signature = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('pspSignature', signature);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Deposit processed and balance credited', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('PROCESSED');",
                  "    pm.expect(jsonData.psp_reference_id).to.eql(pm.collectionVariables.get('lastPspRefId'));",
                  "    pm.expect(jsonData.credited_amount).to.eql(5000);",
                  "    pm.expect(jsonData.new_balance).to.be.at.least(5000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantAlphaId}}" },
              { "key": "X-PSP-Signature", "value": "{{pspSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{depositPayload}}"
            },
            "url": {
              "raw": "{{baseUrl}}/callbacks/psp/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["callbacks", "psp", "deposit"]
            }
          }
        },
        {
          "name": "3.2 PSP Deposit Callback - Duplicate Idempotency Replay",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK on duplicate', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Idempotency recognized and no double-crediting occurred', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('PROCESSED');",
                  "    pm.expect(jsonData.is_duplicate).to.be.true;",
                  "    pm.expect(jsonData.psp_reference_id).to.eql(pm.collectionVariables.get('lastPspRefId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantAlphaId}}" },
              { "key": "X-PSP-Signature", "value": "{{pspSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{depositPayload}}"
            },
            "url": {
              "raw": "{{baseUrl}}/callbacks/psp/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["callbacks", "psp", "deposit"]
            }
          }
        },
        {
          "name": "3.3 PSP Deposit Callback - Invalid HMAC Signature (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Returns ERR_INVALID_SIGNATURE', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql('ERR_INVALID_SIGNATURE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantAlphaId}}" },
              { "key": "X-PSP-Signature", "value": "invalid_signature_hash_0000000000" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{depositPayload}}"
            },
            "url": {
              "raw": "{{baseUrl}}/callbacks/psp/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["callbacks", "psp", "deposit"]
            }
          }
        },
        {
          "name": "3.4 PSP Deposit Callback - Expired Timestamp Replay Attack (401/400)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const pspRefId = 'psp_replay_' + Date.now();",
                  "const expiredTimestamp = Math.floor(Date.now() / 1000) - 600; // 10 minutes ago",
                  "const payload = JSON.stringify({",
                  "    event_type: 'DEPOSIT_SUCCESS',",
                  "    event_id: 'evt_exp_' + Date.now(),",
                  "    tenant_id: pm.collectionVariables.get('tenantAlphaId'),",
                  "    user_id: pm.collectionVariables.get('userIdAlpha'),",
                  "    psp_reference_id: pspRefId,",
                  "    amount: 5000,",
                  "    currency: 'EUR',",
                  "    timestamp: expiredTimestamp",
                  "});",
                  "pm.collectionVariables.set('expiredPayload', payload);",
                  "const secret = pm.collectionVariables.get('pspSecretAlpha');",
                  "const sig = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('expiredSignature', sig);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 or 401 on expired timestamp', function () {",
                  "    pm.expect([400, 401]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Rejects with ERR_TIMESTAMP_EXPIRED', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql('ERR_TIMESTAMP_EXPIRED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantAlphaId}}" },
              { "key": "X-PSP-Signature", "value": "{{expiredSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{expiredPayload}}"
            },
            "url": {
              "raw": "{{baseUrl}}/callbacks/psp/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["callbacks", "psp", "deposit"]
            }
          }
        }
      ]
    },

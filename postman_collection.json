                  "    win_amount: 8000, // 80.00 EUR",
                  "    currency: 'EUR',",
                  "    timestamp: timestamp",
                  "});",
                  "pm.collectionVariables.set('winPayload', payload);",
                  "const secret = pm.collectionVariables.get('gspSecretAlpha');",
                  "const sig = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('gspWinSignature', sig);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Round settled and win credited', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('SETTLED');",
                  "    pm.expect(jsonData.round_id).to.eql(pm.collectionVariables.get('lastRoundId'));",
                  "    pm.expect(jsonData.win_amount).to.eql(8000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],

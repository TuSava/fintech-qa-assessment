                  "pm.test('Returns structured error ERR_USER_EXISTS', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql('ERR_USER_EXISTS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }

    {
      "name": "05. Multi-Tenant Isolation & Security",
      "item": [
        {
          "name": "5.1 Register User in Tenant Beta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const rand = Math.floor(Math.random() * 1000000);",
                  "pm.collectionVariables.set('regEmailBeta', `user_beta_${rand}@fintech.test`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created for Tenant Beta', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.collectionVariables.set('userIdBeta', jsonData.user_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantBetaId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_id\": \"{{tenantBetaId}}\",\n  \"email\": \"{{regEmailBeta}}\",\n  \"password\": \"SecurePassBeta123!\",\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "5.2 Cross-Tenant IDOR - Access Tenant Beta Wallet with Tenant Alpha Token (403/404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 403 Forbidden or 404 Not Found', function () {",
                  "    pm.expect([403, 404]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Tenant leakage blocked: zero financial data exposed', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.available_balance).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "X-Tenant-ID", "value": "{{tenantBetaId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/balance?user_id={{userIdBeta}}",
              "host": ["{{baseUrl}}"],
              "path": ["wallet", "balance"],
              "query": [
                { "key": "user_id", "value": "{{userIdBeta}}" }
              ]
            }
          }
        },
        {
          "name": "5.3 Cross-Tenant Key Mismatch - Tenant Alpha Secret on Tenant Beta Webhook (401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const payload = JSON.stringify({",
                  "    event_type: 'DEPOSIT_SUCCESS',",
                  "    event_id: 'evt_cross_' + Date.now(),",
                  "    tenant_id: pm.collectionVariables.get('tenantBetaId'),",
                  "    user_id: pm.collectionVariables.get('userIdBeta'),",
                  "    psp_reference_id: 'psp_cross_' + Date.now(),",
                  "    amount: 10000,",
                  "    currency: 'USD',",
                  "    timestamp: Math.floor(Date.now() / 1000)",
                  "});",
                  "pm.collectionVariables.set('crossPayload', payload);",
                  "// Signed with WRONG key (Alpha key instead of Beta key)",
                  "const wrongSecret = pm.collectionVariables.get('pspSecretAlpha');",
                  "const sig = CryptoJS.HmacSHA256(payload, wrongSecret).toString(CryptoJS.enc.Hex);",
                  "pm.collectionVariables.set('crossSignature', sig);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized for cross-tenant secret', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Returns ERR_INVALID_SIGNATURE', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql('ERR_INVALID_SIGNATURE');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-ID", "value": "{{tenantBetaId}}" },
              { "key": "X-PSP-Signature", "value": "{{crossSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{crossPayload}}"
            },
            "url": {
              "raw": "{{baseUrl}}/callbacks/psp/deposit",
              "host": ["{{baseUrl}}"],
              "path": ["callbacks", "psp", "deposit"]
            }
          }
        }
      ]
    },
